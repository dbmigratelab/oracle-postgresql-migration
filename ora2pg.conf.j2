ORACLE_DSN dbi:Oracle:host={{ oracle_host }};service_name={{ oracle_service }};port={{ oracle_port }}
ORACLE_USER {{ oracle_user }}
ORACLE_PWD {{ oracle_password }}
SCHEMA {{ migration_schema }}
{% if migration_type != 'ASSESSMENT' %}
PG_DSN dbi:Pg:dbname={{ postgres_db }};host={{ postgres_host }};port={{ postgres_port }}
PG_USER {{ postgres_user }}
PG_PWD {{ postgres_password }}
PG_SCHEMA {{ postgres_schema_map.get(migration_schema, migration_schema | lower) }}
SEARCH_PATH {{ postgres_schema_map.get(migration_schema, migration_schema | lower) }}
{% endif %}
USER_GRANTS 0
EXPORT_SCHEMA 1
CREATE_SCHEMA 0
FILE_PER_CONSTRAINT 1
FILE_PER_INDEX 1
FILE_PER_FKEYS 1
FILE_PER_TABLE 0
FILE_PER_FUNCTION 0
STOP_ON_ERROR 1
TRUNCATE_TABLE 0
PSQL_RELATIVE_PATH 1
